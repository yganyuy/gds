@tool
extends Node

## 骨骼动画轨道工具组件
## 一键补轨道 / 监听属性变化按当前时间轴插帧 / 按时间范围删除关键帧

# ==================== 基础引用 ====================

@export var 骨架: Skeleton2D
@export var 动画播放器: AnimationPlayer
@export var 属性名列表: PackedStringArray = ["rotation"]

@export var 目标动画名: String = ""
## 必填。脚本会锁定此动画，不依赖 current_animation。
## 不知道填什么？先点下方"从动画面板同步动画名"按钮。

@export var 插入初始关键帧: bool = true
@export var 初始关键帧时间: float = 0.0

# ==================== 监听插帧 ====================

@export_group("监听插帧")
@export var 监听属性变化自动插帧: bool = false:
	set(值):
		监听属性变化自动插帧 = 值
		if Engine.is_editor_hint():
			set_process(值)

@export var 属性变化阈值: float = 0.001

# ==================== 删除帧 ====================

@export_group("删除帧")
@export var 删除范围秒数: float = 0.1

# ==================== 调试 ====================

@export_group("调试")
@export var 显示诊断日志: bool = true

# ==================== 工具按钮 ====================

@export_tool_button("从动画面板同步动画名") var _同步按钮 = _同步动画面板动画
@export_tool_button("为所有骨骼添加轨道") var _添加轨道按钮 = _执行添加轨道
@export_tool_button("时间轴 +0.1s") var _加时间按钮 = _推进时间轴
@export_tool_button("时间轴 -0.1s") var _回退时间按钮 = _回退时间轴
@export_tool_button("删除当前时间附近的关键帧") var _删除按钮 = _执行删除帧

# ==================== 内部状态 ====================

var _属性缓存: Dictionary = {}
var _上次时间轴位置: float = -1.0
var _上次动画名: String = ""
var _缓存已初始化: bool = false
var _上次打印毫秒: int = 0
var _无动画提醒过: bool = false

# ==================== 生命周期 ====================

func _ready() -> void:
	if Engine.is_editor_hint():
		set_process(监听属性变化自动插帧)

func _process(_delta: float) -> void:
	if not Engine.is_editor_hint():
		return
	if not 监听属性变化自动插帧:
		return
	if not is_inside_tree():
		return
	_监听插帧()

# ==================== 核心监听 ====================

func _监听插帧() -> void:
	var 播放器 := 获取动画播放器()
	if 播放器 == null:
		_诊断("未找到 AnimationPlayer")
		return
	var 动画名 := _解析动画名(播放器)
	if 动画名 == "":
		if not _无动画提醒过:
			_无动画提醒过 = true
			print("[骨骼动画轨道] 请先填写 '目标动画名'，或点 '从动画面板同步动画名' 按钮。")
		return
	_无动画提醒过 = false

	var 动画 := 播放器.get_animation(动画名)
	if 动画 == null:
		_诊断("动画不存在：" + 动画名)
		return

	# 锁定播放器到目标动画（play + pause），确保 current_animation_position 可用
	if 播放器.current_animation != 动画名:
		播放器.play(动画名)
		播放器.pause()
		return   # 本帧只做初始化，下一帧再监听

	var 骨架引用 := 获取骨架()
	if 骨架引用 == null:
		_诊断("骨架引用为空")
		return
	var 骨骼列表 := _收集所有骨骼(骨架引用)
	if 骨骼列表.is_empty():
		_诊断("骨架下没有 Bone2D")
		return

	var 当前时间轴 := 播放器.current_animation_position
	var 时间轴在动 := not is_equal_approx(当前时间轴, _上次时间轴位置) or 动画名 != _上次动画名

	if not _缓存已初始化 or 时间轴在动:
		_刷新缓存(骨骼列表)
		_上次时间轴位置 = 当前时间轴
		_上次动画名 = 动画名
		_缓存已初始化 = true
		return

	var 根节点 := _获取根节点(播放器)
	for 骨骼 in 骨骼列表:
		for 属性名 in 属性名列表:
			var 键 := str(骨骼.get_path()) + ":" + 属性名
			var 当前值 = 骨骼.get(属性名)
			if 当前值 == null:
				continue
			if not _属性缓存.has(键):
				_属性缓存[键] = 当前值
				continue
			var 旧值 = _属性缓存[键]
			if _值相等(旧值, 当前值):
				continue

			_属性缓存[键] = 当前值
			var 相对路径 := str(根节点.get_path_to(骨骼)) + ":" + 属性名
			var 轨道索引 := 动画.find_track(NodePath(相对路径), Animation.TYPE_VALUE)
			if 轨道索引 == -1:
				轨道索引 = 动画.add_track(Animation.TYPE_VALUE)
				动画.track_set_path(轨道索引, NodePath(相对路径))
			动画.track_insert_key(轨道索引, 当前时间轴, 当前值)
			print("[监听插帧] %s.%s %s → %s @ %.3fs" % [
				骨骼.name, 属性名, str(旧值), str(当前值), 当前时间轴])
			EditorInterface.mark_scene_as_unsaved()

# ==================== 动画名解析 ====================

func _解析动画名(播放器: AnimationPlayer) -> String:
	if 目标动画名 != "":
		return 目标动画名
	return 播放器.current_animation

func _同步动画面板动画() -> void:
	var 播放器 := 获取动画播放器()
	if 播放器 == null:
		push_warning("[骨骼动画轨道] 未找到 AnimationPlayer")
		return
	if 播放器.current_animation == "":
		push_warning("[骨骼动画轨道] current_animation 为空。请先在动画面板下拉框选中动画，点一下播放（空格），再点一次暂停，然后再点此按钮。")
		return
	目标动画名 = 播放器.current_animation
	print("[骨骼动画轨道] 已锁定动画：", 目标动画名)

# ==================== 添加轨道 ====================

func _执行添加轨道() -> void:
	var 骨架引用 := 获取骨架()
	if 骨架引用 == null:
		push_error("[骨骼动画轨道] 请先引用骨架")
		return
	var 播放器 := 获取动画播放器()
	if 播放器 == null:
		push_error("[骨骼动画轨道] 未找到 AnimationPlayer")
		return
	var 骨骼列表 := _收集所有骨骼(骨架引用)
	if 骨骼列表.is_empty():
		push_error("[骨骼动画轨道] 骨架下没有 Bone2D")
		return

	var 根节点 := _获取根节点(播放器)
	var 新增 := 0
	var 动画总数 := 0
	for 库名 in 播放器.get_animation_library_list():
		var 库 := 播放器.get_animation_library(库名)
		for 动画名 in 库.get_animation_list():
			动画总数 += 1
			新增 += _为动画补齐轨道(库.get_animation(动画名), 根节点, 骨骼列表)

	if 动画总数 == 0:
		push_warning("[骨骼动画轨道] 播放器里没有动画")
		return
	print("[骨骼动画轨道] %d 动画 × %d 骨骼，新增 %d 轨道" % [
		动画总数, 骨骼列表.size(), 新增])
	EditorInterface.mark_scene_as_unsaved()

func _为动画补齐轨道(动画: Animation, 根节点: Node, 骨骼列表: Array[Bone2D]) -> int:
	var 新增 := 0
	for 骨骼 in 骨骼列表:
		var 相对 := str(根节点.get_path_to(骨骼))
		for 属性名 in 属性名列表:
			var 值 = 骨骼.get(属性名)
			if 值 == null:
				continue
			新增 += _确保轨道存在(动画, 相对 + ":" + 属性名, 值)
	return 新增

func _确保轨道存在(动画: Animation, 路径字符串: String, 初始值) -> int:
	var 路径 := NodePath(路径字符串)
	for i in range(动画.get_track_count()):
		if 动画.track_get_type(i) == Animation.TYPE_VALUE and 动画.track_get_path(i) == 路径:
			return 0
	var 索引 := 动画.add_track(Animation.TYPE_VALUE)
	动画.track_set_path(索引, 路径)
	if 插入初始关键帧:
		动画.track_insert_key(索引, 初始关键帧时间, 初始值)
	return 1

# ==================== 删除帧 ====================

func _执行删除帧() -> void:
	var 播放器 := 获取动画播放器()
	if 播放器 == null:
		push_error("[删除帧] 未找到 AnimationPlayer")
		return
	var 动画名 := _解析动画名(播放器)
	if 动画名 == "":
		push_error("[删除帧] 未指定动画，请填写 目标动画名")
		return
	var 动画 := 播放器.get_animation(动画名)
	if 动画 == null:
		return

	var 当前 := 播放器.current_animation_position
	var 最小 := 当前 - 删除范围秒数
	var 最大 := 当前 + 删除范围秒数
	var 删除数 := 0
	for 轨道 in range(动画.get_track_count()):
		for 帧 in range(动画.track_get_key_count(轨道) - 1, -1, -1):
			var 时间 := 动画.track_get_key_time(轨道, 帧)
			if 时间 >= 最小 and 时间 <= 最大:
				动画.track_remove_key(轨道, 帧)
				删除数 += 1
	print("[删除帧] 删除 %d 个关键帧（%.3f~%.3fs）" % [删除数, 最小, 最大])
	EditorInterface.mark_scene_as_unsaved()
	_缓存已初始化 = false

# ==================== 时间轴按钮 ====================

func _推进时间轴() -> void:
	_调整时间轴(0.1)

func _回退时间轴() -> void:
	_调整时间轴(-0.1)

func _调整时间轴(增量: float) -> void:
	var 播放器 := 获取动画播放器()
	if 播放器 == null:
		push_warning("[骨骼动画轨道] 未找到 AnimationPlayer")
		return
	var 动画名 := _解析动画名(播放器)
	if 动画名 == "":
		push_warning("[骨骼动画轨道] 未指定动画，请填写 目标动画名")
		return
	if 播放器.current_animation != 动画名:
		播放器.play(动画名)
		播放器.pause()
	var 新位置 := maxf(0.0, 播放器.current_animation_position + 增量)
	播放器.seek(新位置, true)
	_上次时间轴位置 = -1.0
	print("[骨骼动画轨道] 时间轴 → %.3fs" % 新位置)

# ==================== 工具函数 ====================

func _诊断(消息: String) -> void:
	if not 显示诊断日志:
		return
	var 现在 := Time.get_ticks_msec()
	if 现在 - _上次打印毫秒 < 500:
		return
	_上次打印毫秒 = 现在
	print("[诊断] ", 消息)

func _刷新缓存(骨骼列表: Array[Bone2D]) -> void:
	_属性缓存.clear()
	for 骨骼 in 骨骼列表:
		for 属性名 in 属性名列表:
			var 值 = 骨骼.get(属性名)
			if 值 != null:
				_属性缓存[str(骨骼.get_path()) + ":" + 属性名] = 值

func _值相等(a, b) -> bool:
	if a is float and b is float:
		return abs(a - b) <= 属性变化阈值
	if a is Vector2 and b is Vector2:
		return a.distance_to(b) <= 属性变化阈值
	return a == b

func _收集所有骨骼(节点: Node) -> Array[Bone2D]:
	var 结果: Array[Bone2D] = []
	for 子 in 节点.get_children():
		if 子 is Bone2D:
			结果.append(子)
		结果.append_array(_收集所有骨骼(子))
	return 结果

func _获取根节点(播放器: AnimationPlayer) -> Node:
	var 根 := 播放器.get_node_or_null(播放器.root_node)
	return 根 if 根 != null else 播放器

func 获取动画播放器() -> AnimationPlayer:
	if 动画播放器 != null:
		return 动画播放器
	var 根: Node = null
	if Engine.is_editor_hint():
		根 = EditorInterface.get_edited_scene_root()
	else:
		根 = get_tree().current_scene
	if 根 == null:
		return null
	return _按类型向下查找(根, "AnimationPlayer") as AnimationPlayer

func 获取骨架() -> Skeleton2D:
	return 骨架

func _按类型向下查找(节点: Node, 类型名: String) -> Node:
	if 节点.is_class(类型名):
		return 节点
	for 子 in 节点.get_children():
		var 找到 := _按类型向下查找(子, 类型名)
		if 找到:
			return 找到
	return null
